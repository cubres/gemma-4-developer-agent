+def _directory_identity_without_symlinks(path: Path) -> tuple[int, int]:
+    fd = directory_fd_without_symlinks(path)
+    try:
+        metadata = os.fstat(fd)
+        return metadata.st_dev, metadata.st_ino
+    finally:
+        os.close(fd)
+
